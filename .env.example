# ===== 百炼平台 =====
# 阿里云百炼 API Key，获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=<your-dashscope-api-key>

# ===== Chinese-CLIP（本地） =====
# 无需 API Key，模型首次加载自动下载
CHINESE_CLIP_MODEL=C:\path\to\chinese-clip-vit-base-patch16
# 默认懒加载；设为 true 时在 FastAPI 启动阶段自动预热
ENABLE_MODEL_WARMUP=false
CHROMA_PERSIST_DIR=./chroma_data

# ===== Chroma（本地） =====
# 无需额外配置，默认持久化到 ./chroma_data/

# ===== MinIO（本地开发示例） =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>
MINIO_SECURE=false
MINIO_BUCKET=shopping-qna

# ===== LangSmith（可选） =====
LANGCHAIN_API_KEY=<your-langsmith-api-key>
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=ShoppingQnA-Bailian

# ===== Neo4j（可选） =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# ===== Outfit Provider =====
# 当前推荐主链直接使用 Neo4j，不执行内存降级
OUTFIT_PROVIDER=neo4j

# ===== 本地开发 JWT（禁止用于生产） =====
# 请替换为至少 32 字节的随机值，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
DEV_JWT_SECRET=<至少32字节随机开发密钥>
DEV_JWT_ISSUER=shopping-qna-dev
DEV_JWT_AUDIENCE=shopping-qna-api

# ===== PostgreSQL / 多租户记忆 =====
POSTGRES_PASSWORD=<至少16字符随机密码>
MEMORY_MIGRATOR_DB_PASSWORD=<至少16字符随机密码>
MEMORY_API_DB_PASSWORD=<至少16字符随机密码>
MEMORY_WORKER_DB_PASSWORD=<至少16字符随机密码>
MEMORY_POLLER_DB_PASSWORD=<至少16字符随机密码>
MEMORY_MAINTENANCE_DB_PASSWORD=<至少16字符随机密码>
DATABASE_URL=postgresql://shopping_memory_api_login:<api密码>@localhost:5432/shopping_qna_dev
MEMORY_WORKER_DATABASE_URL=postgresql://shopping_memory_worker_login:<worker密码>@localhost:5432/shopping_qna_dev
MEMORY_POLLER_DATABASE_URL=postgresql://shopping_memory_poller_login:<poller密码>@localhost:5432/shopping_qna_dev
MEMORY_READ_ENABLED=true
MEMORY_WRITE_ENABLED=true
SEMANTIC_MEMORY_ENABLED=true
EPISODIC_MEMORY_ENABLED=true
PROCEDURAL_MEMORY_ENABLED=true
